<section class="mx-auto max-w-7xl px-5 pb-20 sm:px-8 lg:px-12">
  <div class="grid grid-cols-1 gap-4 md:grid-cols-12">
    <figure class="group relative h-80 overflow-hidden md:col-span-7 md:h-[32rem]">
      <img
        src="/images/velo-route.jpg"
        alt="Albéric avec son vélo sur une route du Limousin"
        class="h-full w-full object-cover object-[50%_35%] transition duration-700 group-hover:scale-105"
      />
      <figcaption class="absolute bottom-0 left-0 bg-vert px-4 py-3 text-xs text-cream">
        Au départ du Buis pour notre périple.
      </figcaption>
    </figure>
    <div class="grid gap-4 md:col-span-5">
      <figure class="group relative h-80 overflow-hidden md:h-[32rem]">
        <img
          src="/images/coucher-soleil.jpg"
          alt="Coucher de soleil sur les prés limousins"
          class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
        />
        <figcaption class="absolute bottom-0 right-0 bg-vert px-4 py-3 text-xs text-cream">
          80 kilomètres de paysages.
        </figcaption>
      </figure>
    </div>
    <figure class="group relative h-72 overflow-hidden md:col-span-6">
      <img
        src="/images/marie.jpg"
        alt="Marie avec Clément et Albéric devant la vigne"
        class="h-full w-full object-cover object-[50%_45%] transition duration-700 group-hover:scale-105"
      />
      <figcaption class="absolute bottom-0 left-0 bg-vert px-4 py-3 text-xs text-cream">
        Une rencontre à Bellac.
      </figcaption>
    </figure>
    <figure class="group relative h-72 overflow-hidden md:col-span-6">
      <img
        src="/images/mathilde.jpg"
        alt="Mathilde avec Clément et Albéric devant la ferme"
        class="h-full w-full object-cover object-[50%_28%] transition duration-700 group-hover:scale-105"
      />
      <figcaption class="absolute bottom-0 right-0 bg-vert px-4 py-3 text-xs text-cream">
        Une halte à Compreignac.
      </figcaption>
    </figure>
    <figure class="group relative h-64 overflow-hidden md:col-span-4">
      <img
        src="/images/galerie-ciel-route.jpg"
        alt="Ciel d'été au-dessus d'une route limousine"
        class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
      />
    </figure>
    <figure class="group relative h-64 overflow-hidden md:col-span-4">
      <img
        src="/images/galerie-ciel-large.jpg"
        alt="Grand ciel de fin de journée sur le Limousin"
        class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
      />
    </figure>
    <figure class="group relative h-64 overflow-hidden md:col-span-4">
      <img
        src="/images/galerie-halte-velo.jpg"
        alt="Halte à vélo au bord de l'eau"
        class="h-full w-full object-cover object-[50%_35%] transition duration-700 group-hover:scale-105"
      />
    </figure>
  </div>
</section>
