---
import EpisodeCard from "./EpisodeCard.astro";
---

<section id="episodes" class="mx-auto max-w-7xl px-5 py-20 sm:px-8 md:py-28 lg:px-12">
  <div
    class="mb-12 flex flex-col justify-between gap-6 border-b border-granit/15 pb-8 md:flex-row md:items-end"
  >
    <div>
      <p class="text-xs font-medium uppercase tracking-[0.16em] text-ocre">Les rencontres</p>
      <h2 class="mt-4 text-4xl tracking-tight sm:text-5xl font-serif">Trois voix du coin</h2>
    </div>
  </div>

  <EpisodeCard
    numero="E01"
    lieu="Bellac"
    badge="Avec Marie - 30 minutes"
    titre="Ce qui nous relie"
    description="À Bellac, Marie parle de lien social, de lieux où l’on se retrouve, et de ce que ça change de faire des choses ensemble. Une discussion sur l’engagement local, les rencontres, et les petits gestes qui tiennent un territoire debout."
    imageSrc="/images/marie-individuelle.jpeg"
    imageAlt="Marie"
    bordered
  />

  <EpisodeCard
    numero="E02"
    lieu="Compreignac"
    badge="Avec Mathilde - 30 minutes"
    titre="Les mains dans les saisons"
    description="À Compreignac, Mathilde cultive des fleurs comestibles. Elle raconte son rapport aux saisons, au sol, au vivant, et ce que ça veut dire de travailler avec un climat qui change."
    imageSrc="/images/mathilde-individuelle.jpeg"
    imageAlt="Mathilde"
    bordered
  />

  <EpisodeCard
    numero="E03"
    lieu="Bellac"
    badge="Avec Solène (et Adam) - 30 minutes"
    titre="Créer ici"
    description="À Bellac, Solène et Adam construisent leur projet à leur manière. Ils parlent de choix de vie, de travail, de ruralité, et de ce que ça implique de créer quelque chose ici plutôt qu’ailleurs."
    imageSrc="/images/solene-adam-individuelle.jpeg"
    imageAlt="Solène et Adam"
  />
</section>
